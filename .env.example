# ==============================================================================
# NetPath — Deterministic Network Path Analysis & Root-Cause Diagnosis Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# Project Metadata
PROJECT_NAME="NetPath — Deterministic Network Path Analysis & Root-Cause Diagnosis Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Environment Mode
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Database Configuration
# Primary: MySQL 8 (Docker / Production)
DATABASE_URL="mysql+pymysql://netpath_user:netpath_password@localhost:3306/netpath_db"
# Fallback: SQLite is automatically used if MySQL connection fails
# DATABASE_URL="sqlite:///./netpath.db"
SQL_ECHO=false

# Security & SSRF Protection
# CAUTION: Set ALLOW_PRIVATE_IPS=true only in isolated testing environments
ALLOW_PRIVATE_IPS=false
ALLOWLISTED_HOSTS=["test-service-a", "test-service-b", "test-service-c", "localhost", "127.0.0.1"]

# Analysis & Collector Timeouts
PROBE_TIMEOUT_SECONDS=8.0
MIN_BASELINE_SAMPLES=10
BASELINE_LOOKBACK_SAMPLES=100

# Deterministic Evidence Scoring Weights
SCORE_DNS_ANOMALY=3
SCORE_TCP_FAILURE=4
SCORE_TCP_DEGRADATION=2
SCORE_TLS_FAILURE=4
SCORE_TLS_EXPIRING=3
SCORE_HTTP_ERROR=4
SCORE_HTTP_LATENCY=3
SCORE_PACKET_LOSS=3
SCORE_BASELINE_VIOLATION=2
SCORE_INTERFACE_DROPS=2

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "*"]
